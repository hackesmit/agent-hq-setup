# Every 5 minutes (bead hq-w32vy.2). The n8n Gmail Trigger also polls every
# 5 minutes, so a new mail reaches a draft within about 10 minutes.
[Unit]
Description=Work inbox watcher every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=20
Unit=mail-watch.service

[Install]
WantedBy=timers.target
