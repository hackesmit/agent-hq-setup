# ops/.env — gitignored secrets/config for HQ scripts. Copy to ops/.env and fill in.
# NEVER commit the real ops/.env (it is in .gitignore).

# ntfy.sh topic that notify.sh publishes to (required for notifications).
NTFY_TOPIC=your-private-ntfy-topic

# --- Proton Pass (DEFERRED enabler, 2026-07-13) ---
# Only needed once pass-cli is installed and you want CC to pull passwords via `pp`.
# proton-pass-guard.sh reads these; leave unset to keep the Proton plumbing inert.
# PROTON_ACCOUNT=you@proton.me
# PROTON_MASTER_PW='your-master-password'
