{
  "_comment": [
    "What must run on hqbox, read by ops/scripts/drift-check.sh (hq-fgg3.1).",
    "This file declares only what no other registry already says. drift-check",
    "reads the others directly instead of copying them: loops and their heartbeats",
    "are ops/mail/heartbeats.json, failure-reporting coverage is ops/mail/coverage.json,",
    "the console's job and service views are ops/projects/console/jobs.json and",
    "services.json, OnFailure wiring is ops/services/failure-notify/install.sh, and",
    "the hq session's windows are started by ops/scripts/hq.sh. Every unit the",
    "console's services.json shows must be declared here; drift-check checks that.",
    "units[].run: daemon (enabled and active), timer or socket (the <base>.timer or",
    "<base>.socket is enabled and active, the service did not fail), triggered",
    "(started by another unit; only checked for failure), template (the file exists).",
    "units[].on_failure: required (an OnFailure= must be set) or exempt:<reason>.",
    "units[].success_exit_ok: <reason> allows a non-zero SuccessExitStatus on purpose.",
    "units[].source: the repo copy; the installed copy must match it, comments and",
    "blank lines ignored. null means the unit comes from a package.",
    "units[].trigger_source: for run timer or socket, the repo copy of the trigger; default is",
    "the source with .timer or .socket, always compared (a missing file is source-missing).",
    "null says the trigger has no repo copy on purpose.",
    "switches: every flag file that changes behaviour. A switch that is ON must have",
    "an on record with an expires date and an owner. Turning a switch off means",
    "deleting the file AND setting on back to null.",
    "gate_paths: the paths drift-check reads in the hq repo (fnmatch, * spans /). finish.sh runs its",
    "drift gate only when a merge touches one of them, a declared unit, trigger or installed-file",
    "source, a claim file, a declared switch path, a flag-shaped file under a switch_scan root, or,",
    "for a rig merge, a coverage.json evidence file inside that rig (drift-check --gate-relevant).",
    "Retiring something is an edit here: remove its entry, and drift-check reports",
    "every place it still runs."
  ],
  "host": "hqbox",
  "units": [
    {"unit": "tmux-hq.service", "scope": "user", "run": "daemon", "source": "ops/services/hqbox-terminals/tmux-hq.service", "on_failure": "required", "owner": "hq-boot"},
    {"unit": "ob-sync.service", "scope": "user", "run": "daemon", "source": "ops/services/vault-headless/ob-sync.service", "on_failure": "required", "owner": "ob-sync"},
    {"unit": "ob-sync-heartbeat.service", "scope": "user", "run": "timer", "source": "ops/services/vault-headless/ob-sync-heartbeat.service", "on_failure": "required", "owner": "ob-sync"},
    {"unit": "code-server.service", "scope": "user", "run": "daemon", "source": null, "on_failure": "exempt:package unit, a convenience editor with nothing depending on it", "owner": "hqbox-terminals"},
    {"unit": "hq-mail-poll.service", "scope": "user", "run": "timer", "source": "ops/services/hq-mail/hq-mail-poll.service", "on_failure": "required", "owner": "hq-mail"},
    {"unit": "hq-mail-digest.service", "scope": "user", "run": "timer", "source": "ops/services/hq-mail/hq-mail-digest.service", "on_failure": "required", "owner": "hq-mail"},
    {"unit": "hq-mail-drain.service", "scope": "user", "run": "timer", "source": "ops/services/hq-mail/hq-mail-drain.service", "on_failure": "required", "owner": "hq-mail"},
    {"unit": "plan-usage.service", "scope": "user", "run": "timer", "source": "ops/services/plan-usage/plan-usage.service", "on_failure": "required", "owner": "plan-usage"},
    {"unit": "otel-ledger.service", "scope": "user", "run": "daemon", "source": "ops/services/otel-ledger/otel-ledger.service", "on_failure": "required", "owner": "otel-ledger"},
    {"unit": "hq-mail-failure@.service", "scope": "user", "run": "template", "source": "ops/services/hq-mail/hq-mail-failure@.service", "on_failure": "exempt:it is the failure handler", "owner": "hq-mail"},
    {"unit": "hq-failure-notify@.service", "scope": "user", "run": "template", "source": "ops/services/failure-notify/hq-failure-notify@.service", "on_failure": "exempt:it is the failure handler", "owner": "failure-notify"},
    {"unit": "hq-beads-backup.service", "scope": "user", "run": "timer", "source": "ops/services/beads-backup/hq-beads-backup.service", "on_failure": "required", "owner": "hq-beads-backup"},
    {"unit": "hq-db-dump.service", "scope": "user", "run": "timer", "source": "ops/services/db-dumps/hq-db-dump.service", "on_failure": "required", "owner": "hq-db-dump"},
    {"unit": "mail-watch.service", "scope": "user", "run": "timer", "source": "ops/services/mail-watch/mail-watch.service", "on_failure": "required", "owner": "mail-watch"},
    {"unit": "hq-session-archive.service", "scope": "user", "run": "timer", "source": "ops/services/session-archive/hq-session-archive.service", "on_failure": "required", "owner": "hq-session-archive"},
    {"unit": "hq-weekly-review.service", "scope": "user", "run": "timer", "source": "ops/services/weekly-review/hq-weekly-review.service", "on_failure": "required", "owner": "hq-weekly-review"},
    {"unit": "hq-retro.service", "scope": "user", "run": "timer", "source": "ops/services/retro/hq-retro.service", "on_failure": "required", "owner": "retro"},
    {"unit": "hq-reaper.service", "scope": "user", "run": "timer", "source": "ops/services/reaper/hq-reaper.service", "on_failure": "required", "owner": "reaper"},
    {"unit": "hq-drift-boot.service", "scope": "user", "run": "timer", "source": "ops/services/drift-check/hq-drift-boot.service", "on_failure": "required", "owner": "hq-drift"},
    {"unit": "hq-wake-resume.service", "scope": "user", "run": "timer", "source": "ops/services/snooze-resume/hq-wake-resume.service", "on_failure": "required", "owner": "snooze"},
    {"unit": "hq-orchestrator.path", "scope": "user", "run": "daemon", "source": "ops/services/orchestrator/hq-orchestrator.path", "on_failure": "exempt:a path unit only watches files; hq-orchestrator.service carries the alert", "owner": "hq-orchestrator"},
    {"unit": "hq-orchestrator.service", "scope": "user", "run": "timer", "source": "ops/services/orchestrator/hq-orchestrator.service", "on_failure": "required", "owner": "hq-orchestrator"},
    {"unit": "hq-orchestrator-audit.service", "scope": "user", "run": "timer", "source": "ops/services/orchestrator/hq-orchestrator-audit.service", "on_failure": "required", "owner": "hq-orchestrator"},
    {"unit": "avance-guardia.service", "scope": "user", "run": "timer", "source": "ops/services/acme-financial/avance-guardia.service", "on_failure": "required", "success_exit_ok": "exit 1 (parity mismatch) and 2 (rules unreadable) are results it reports itself, not unit failures", "owner": "avance-guardia"},
    {"unit": "avance-promover.service", "scope": "user", "run": "timer", "source": "ops/services/acme-financial/avance-promover.service", "on_failure": "required", "owner": "acme-avance"},
    {"unit": "avance-cartera.service", "scope": "user", "run": "timer", "source": null, "trigger_source": null, "on_failure": "required", "owner": "acme-avance"},
    {"unit": "avance-cartera-falla.service", "scope": "user", "run": "triggered", "source": null, "on_failure": "exempt:it is the failure handler of avance-cartera.service", "owner": "acme-avance"},

    {"unit": "hq-console.service", "scope": "system", "run": "daemon", "source": "ops/console/v2/release/units/hq-console.service", "on_failure": "required", "owner": "hq-console"},
    {"unit": "hq-runner.service", "scope": "system", "run": "socket", "source": "ops/console/v2/release/units/hq-runner.service", "on_failure": "required", "owner": "hq-console"},
    {"unit": "hq-hub-sync.service", "scope": "system", "run": "daemon", "source": "ops/console/v2/sync/hq-hub-sync.service", "on_failure": "required", "owner": "hq-console"},
    {"unit": "console-build.service", "scope": "system", "run": "timer", "source": "ops/console/v2/release/units/console-build.service", "on_failure": "required", "owner": "hq-console"},
    {"unit": "hq-console-activate.service", "scope": "system", "run": "triggered", "source": "ops/console/v2/release/units/hq-console-activate.service", "on_failure": "required", "owner": "hq-console"},
    {"unit": "hq-cert-renew.service", "scope": "system", "run": "timer", "source": "ops/console/v2/release/units/hq-cert-renew.service", "on_failure": "required", "owner": "hq-console"},
    {"unit": "hq-restic-backup.service", "scope": "system", "run": "timer", "source": "ops/services/restic-backup/hq-restic-backup.service", "on_failure": "required", "owner": "hq-restic-backup"},
    {"unit": "hq-disk-health.service", "scope": "system", "run": "timer", "source": "ops/services/disk-health/hq-disk-health.service", "on_failure": "required", "owner": "hq-disk-health"},
    {"unit": "hq-deadman.service", "scope": "user", "run": "timer", "source": "ops/services/deadman/hq-deadman.service", "on_failure": "required", "owner": "hq-deadman"},
    {"unit": "hq-deadman-system.service", "scope": "system", "run": "timer", "source": "ops/services/deadman/hq-deadman-system.service", "on_failure": "required", "owner": "hq-deadman"},
    {"unit": "hq-console-probe.service", "scope": "user", "run": "timer", "source": "ops/services/console-probe/hq-console-probe.service", "on_failure": "exempt:a failed probe is already a missed push, which Uptime Kuma marks down", "owner": "console-probe"},
    {"unit": "minecraft-compose.service", "scope": "system", "run": "daemon", "source": "ops/services/minecraft/minecraft-compose.service", "on_failure": "required", "owner": "minecraft"},
    {"unit": "hq-failure-notify-system@.service", "scope": "system", "run": "template", "source": "ops/services/failure-notify/hq-failure-notify-system@.service", "on_failure": "exempt:it is the failure handler", "owner": "failure-notify"}
  ],
  "undeclared_unit_pattern": "^(hq-|hq_|tmux-hq|ob-sync|avance-|console-build|minecraft-|code-server\\.|acme-|lodgeco-|studioco-|peel-|capri|vault-|drift-)",
  "repo_unit_dirs": ["ops/services", "ops/console/v2"],
  "tmux": {
    "session": "hq",
    "servers": ["default", "hqterm"],
    "launcher": "ops/scripts/hq.sh",
    "windows": ["monitor", "sync", "watch", "cpu-watch"],
    "optional": ["work", "parked"],
    "launcher_conditional": {}
  },
  "installed_files": [
    {"installed": "~/.local/bin/hq-weekly-stack-review", "source": "ops/reviews/weekly-stack-review.sh", "owner": "hq-weekly-review", "install": "install -m 0755 ~/hq/ops/reviews/weekly-stack-review.sh ~/.local/bin/hq-weekly-stack-review"},
    {"installed": "~/.config/hq/weekly-stack-review-prompt.md", "source": "ops/reviews/weekly-stack-review-prompt.md", "owner": "hq-weekly-review", "install": "install -m 0644 ~/hq/ops/reviews/weekly-stack-review-prompt.md ~/.config/hq/weekly-stack-review-prompt.md"},
    {"installed": "~/.local/bin/hq-db-dump", "source": "ops/services/db-dumps/hq-db-dump.sh", "owner": "hq-db-dump", "install": "~/hq/ops/services/db-dumps/install.sh"},
    {"installed": "~/.local/bin/hq-session-archive", "source": "ops/scripts/session-archive.sh", "owner": "hq-session-archive", "install": "~/hq/ops/services/session-archive/install.sh"}
  ],
  "gate_paths": ["ops/config/runtime.json", "ops/mail/heartbeats.json", "ops/mail/coverage.json",
                 "ops/mail/hq_mail/heartbeat.py", "ops/mail/hq_mail/coverage.py",
                 "ops/services/*", "ops/console/v2/release/units/*", "ops/console/v2/sync/*",
                 "ops/scripts/hq.sh", "ops/scripts/hook-*.sh", "ops/scripts/drift-check.sh", "ops/scripts/drift_check.py",
                 "ops/scripts/vault-path.sh", "ops/scripts/review.sh", "CLAUDE.md",
                 ".claude/settings.json", ".claude/settings.local.json", "ops/mcp/*",
                 "ops/projects/console/jobs.json", "ops/projects/console/services.json"],
  "hooks_unwired": {},
  "cron": [
    {"match": "tools/hq-watch/consolidate.sh", "owner": "hq-watch", "what": "weekly stall-watch log consolidate"},
    {"match": "ops/services/minecraft/netwatch.sh", "owner": "minecraft", "what": "minecraft relay watchdog every minute"},
    {"match": "ops/config/logrotate-hq.conf", "owner": "hq-fgg3.11", "what": "rotation of git-sync.log and mail-poll.log"}
  ],
  "switches": {
    "ops/mail/LOG_ONLY": {"what": "hq_mail logs instead of acting (no fixer, no reply)", "owner": "hq-mail", "on": null},
    "ops/mail/DISABLED": {"what": "hq_mail poller does nothing", "owner": "hq-mail", "on": null}
  },
  "switch_scan": {
    "roots": ["ops", "state"],
    "max_depth": 3,
    "name_regex": "^[A-Z][A-Z0-9_]{2,}$",
    "ignore_names": ["README", "LICENSE", "CHANGELOG", "MANUAL", "TODO", "AUTHORS", "NOTICE", "VERSION", "CODEOWNERS", "HEAD", "FETCH_HEAD", "ORIG_HEAD"],
    "skip_dirs": ["node_modules", ".git", ".venv", "venv", "dist", "build", "avancevenv", "pgvenv"]
  },
  "claims": [
    {"id": "vault-path", "file": "CLAUDE.md", "regex": "Reading the vault is still allowed: `([^`]+)`", "cmd": ["ops/scripts/vault-path.sh"], "compare": "path", "owner": "CLAUDE.md Vault section"},
    {"id": "vault-exists", "file": "CLAUDE.md", "regex": "Reading the vault is still allowed: `([^`]+)`", "compare": "path_exists", "owner": "ob-sync"},
    {"id": "console-port", "file": "CLAUDE.md", "regex": "hqbox\\.example\\.ts\\.net:(\\d+)", "cmd": ["systemctl", "show", "hq-console.service", "-p", "Environment", "--value"], "compare": "contains", "expect": "CONSOLE_PORT={0}", "owner": "CLAUDE.md Token efficiency, Console bullet"},
    {"id": "lucy-model", "file": ".claude/rules/lucy.md", "regex": "an OpenAI model \\(([^,)]+)", "cmd": ["grep", "-m1", "^MODEL=", "ops/scripts/review.sh"], "compare": "contains", "expect": "\"{0}\"", "owner": ".claude/rules/lucy.md"},
    {"id": "rigs-table", "type": "rigs_table", "file": "CLAUDE.md", "owner": "CLAUDE.md Rigs table"}
  ]
}
