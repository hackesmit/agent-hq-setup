# site.example.env - everything about an HQ install that is about WHOSE it is.
#
# Copy to ops/config/site.env and edit. That file is gitignored, so a fork keeps its own
# identity without ever committing it, and a diff between two installs is a diff of
# behavior rather than of names.
#
# This file exists because the workshop was written for one box and grew identity into
# about a hundred places. The console already reads every value here from its unit
# environment; the shell scripts and the constitution are being moved onto it (see
# docs/SHARING.md for what is done and what is not).
#
#   source ops/config/site.env    # in a shell
#   EnvironmentFile=/home/<you>/hq/ops/config/site.env   # in a systemd unit

# ---------------------------------------------------------------- who and where --

# The account the workshop runs as, and its home. Everything else hangs off this.
HQ_USER=owner
HQ_HOME=/home/owner
HQ_ROOT=/home/owner/hq

# The person the console trusts. On a tailnet this is the tailscale login: the server
# refuses every connection whose whois answer is not this, so it is a real control and
# not a display name.
CONSOLE_OWNER=owner@example.com

# The always-on box that serves the console and runs the workers.
HQ_BOX_HOST=hqbox
# Its name on your tailnet, which is also the TLS certificate name and the WebAuthn
# relying party. There is no default that can work for someone else: this must be set.
CONSOLE_HOST=hqbox.example.ts.net
CONSOLE_PORT=8790

# WebAuthn identity for the meta terminal, if the browser reaches the console by some
# other name than CONSOLE_HOST. Leave unset to derive both from CONSOLE_HOST.
# CONSOLE_META_RP_ID=
# CONSOLE_META_ORIGIN=

# ------------------------------------------------------------------ git and code --

# Where the rigs and this repo live. A fork changes the org and nothing else.
HQ_GIT_HOST=github.com
HQ_GIT_ORG=your-gh-user
HQ_REPO=agent-hq

# --------------------------------------------------------------------- the vault --

# The Obsidian vault the workshop reads and writes through the outbox. On this install
# it is on the Windows side of WSL; on a plain Linux box it is just a directory. Unset
# it and the vault features degrade to the outbox alone, which is a supported shape.
HQ_VAULT=/mnt/c/Users/Dan/Documents/GKB
HQ_VAULT_OUTBOX=/home/owner/hq/outbox/vault

# ------------------------------------------------------------------ daemon users --

# Created by ops/install/hqbox-provision.sh. Renaming them is possible but touches the
# sudoers drop-in and every unit, so it is not a one line change.
HQCONSOLE_USER=hqconsole
HQBUILD_USER=hqbuild
HQSYNC_USER=hqsync

# ----------------------------------------------------------------- notifications --

# ntfy topic for pushes to the phone. Treat it as a secret: anyone who knows the topic
# can read the notifications, so do not reuse this one.
# NTFY_TOPIC=

# ---------------------------------------------------------------------- optional --

# Read-only tokens the cloud collectors use. They belong in the daemon environment, not
# here in the repo copy: see ops/console/v2/release/units/hq-console.service.
# CONSOLE_VERCEL_TOKEN=
# CONSOLE_N8N_URL=
# CONSOLE_N8N_TOKEN=
# CONSOLE_KUMA_URL=
# CONSOLE_KUMA_PAGE=
